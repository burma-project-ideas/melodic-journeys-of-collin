@inherits LayoutComponentBase
@implements IDisposable
@inject ThemeService ThemeService
@inject LibraryStateService LibraryState
@inject NavigationManager Navigation
@inject IJSRuntime JsRuntime

<div class="page-shell collin-shell">
    <a class="collin-skip" href="#main-content">Skip to music</a>
    <div class="radio-banner"><span class="live-dot"></span> INDEPENDENT SOUND. ENDLESS DISCOVERY. <a href="/releases">Explore the collection <span aria-hidden="true">↗</span></a></div>
    <header class="collin-header">
        <a class="collin-brand" href="/" aria-label="Collin Radio home"><BrandLogo Size="34" /><span>collin<span class="brand-period">.</span></span><small>RADIO</small></a>
        <NavSidebar IsMobileMenuOpen="IsMobileNavOpen" OnNavigate="CloseMobileNav" />
        <div class="header-actions"><ThemeToggle /><a class="modern-button primary header-dj" href="/dj">Enter DJ Room <span aria-hidden="true">↗</span></a><button class="mobile-menu-button" type="button" @onclick="ToggleMobileNav" aria-label="Toggle navigation menu" aria-expanded="@IsMobileNavOpen" aria-controls="app-sidebar">@(IsMobileNavOpen ? "×" : "☰")</button></div>
    </header>
    <main id="main-content" class="collin-content">@Body</main>
    <footer class="collin-footer"><a href="/" class="collin-brand"><BrandLogo Size="28" /><span>collin.</span></a><p>Good music. No distractions.</p><div><a href="/about-us">About the journey</a><a href="/profile">Your profile</a></div></footer>
    @if (!IsDjRoute) { <div class="player-dock"><TopPlayerBar /></div> }
    <GlobalAudioHost />
</div>

@code {
    private bool IsMobileNavOpen;
    private bool IsDjRoute => Navigation.Uri.Contains("/dj", StringComparison.OrdinalIgnoreCase);

    protected override void OnInitialized()
    {
        ThemeService.Changed += OnThemeChanged;
        LibraryState.Changed += OnLibraryChanged;
        Navigation.LocationChanged += OnLocationChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await ThemeService.InitializeAsync(JsRuntime);
            await LibraryState.InitializeAsync();
        }
    }

    private void OnThemeChanged() => InvokeAsync(StateHasChanged);

    private void OnLibraryChanged() => InvokeAsync(StateHasChanged);

    private void ToggleMobileNav() => IsMobileNavOpen = !IsMobileNavOpen;

    private void CloseMobileNav() => IsMobileNavOpen = false;

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        IsMobileNavOpen = false;
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        ThemeService.Changed -= OnThemeChanged;
        LibraryState.Changed -= OnLibraryChanged;
        Navigation.LocationChanged -= OnLocationChanged;
    }
}
