<nav id="app-sidebar" class="collin-nav @(IsMobileMenuOpen ? "is-open" : "")" aria-label="Main navigation">
    <NavLink href="/" Match="NavLinkMatch.All" @onclick="HandleNavigate">Discover</NavLink>
    <NavLink href="/releases" @onclick="HandleNavigate">Releases</NavLink>
    <NavLink href="/albums" @onclick="HandleNavigate">Albums</NavLink>
    <NavLink href="/favorites" @onclick="HandleNavigate">Favorites</NavLink>
    <NavLink href="/dj" @onclick="HandleNavigate">DJ Room</NavLink>
    <NavLink href="/profile" @onclick="HandleNavigate">Profile</NavLink>
    <NavLink href="/about-us" @onclick="HandleNavigate">About</NavLink>
</nav>

@code {
    [Parameter]
    public bool IsMobileMenuOpen { get; set; }

    [Parameter]
    public EventCallback OnNavigate { get; set; }

    private async Task HandleNavigate()
    {
        if (OnNavigate.HasDelegate)
        {
            await OnNavigate.InvokeAsync();
        }
    }
}
