@page "/releases"
@page "/releasesNew"
@inject LibraryStateService LibraryState

@{ var tracks = FilteredTracks().ToList(); }

<div class="releases-room">
    <header class="dj-heading">
        <div><span class="modern-eyebrow">COLLIN RADIO / DISCOGRAPHY</span><h1>Good sounds. <em>All in one place.</em></h1><p>Explore the releases, save a favorite, and find your next repeat.</p></div>
        <a class="modern-button secondary" href="/albums">Explore collections ↗</a>
    </header>
    <div class="releases-toolbar">
        <label class="releases-search"><span aria-hidden="true">⌕</span><input type="search" aria-label="Search releases" placeholder="Search tracks, artists, or collections" @bind="SearchTerm" @bind:event="oninput" /></label>
        <button type="button" class="releases-clear" @onclick="ClearSearch" disabled="@(string.IsNullOrEmpty(SearchTerm))">Clear search</button>
        <span class="releases-count" role="status">@tracks.Count track@(tracks.Count == 1 ? string.Empty : "s")</span>
    </div>
    <section class="releases-grid" aria-label="Releases">
        @foreach (var track in tracks)
        {
            <div class="release-item">
                <TrackCard Track="track" />
                @if (!string.IsNullOrWhiteSpace(track.AlbumId)) { <a class="release-collection" href="@($"/albums/{track.AlbumId}")">@track.AlbumTitle <span aria-hidden="true">↗</span></a> }
            </div>
        }
    </section>
    @if (tracks.Count == 0)
    {
        <div class="releases-empty"><span class="modern-eyebrow">NOTHING IN THIS CRATE</span><h2>No releases found.</h2><p>Try another track, artist, genre, or collection.</p><button type="button" class="modern-button secondary" @onclick="ClearSearch">Show all releases</button></div>
    }
    <aside class="albums-invitation"><div><span class="modern-eyebrow">KEEP THE SESSION GOING</span><h2>Take your favorites to the deck.</h2><p>Your music stays with you as you explore the DJ Room.</p></div><a class="modern-button secondary" href="/dj">Open the DJ Room ↗</a></aside>
</div>

@code {
    private string SearchTerm { get; set; } = string.Empty;

    private IEnumerable<MusicInfoModel> FilteredTracks()
    {
        var tracks = MusicService.LocalPlaylist.AsEnumerable();
        if (string.IsNullOrWhiteSpace(SearchTerm))
        {
            return tracks;
        }

        return tracks.Where(track =>
            (track.Name?.Contains(SearchTerm, StringComparison.OrdinalIgnoreCase) ?? false) ||
            (track.Artists?.Contains(SearchTerm, StringComparison.OrdinalIgnoreCase) ?? false) ||
            (track.Genre?.Contains(SearchTerm, StringComparison.OrdinalIgnoreCase) ?? false) ||
            (track.AlbumTitle?.Contains(SearchTerm, StringComparison.OrdinalIgnoreCase) ?? false));
    }

    private void ClearSearch() => SearchTerm = string.Empty;
}
