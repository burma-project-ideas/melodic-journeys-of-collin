@page "/"
@inject PlayerStateService PlayerState
@inject LibraryStateService LibraryState
@implements IDisposable

@{
    var tracks = MusicService.LocalPlaylist;
    var featured = tracks.FirstOrDefault();
    var filtered = tracks.Where(track => string.IsNullOrWhiteSpace(_query) || string.Join(" ", track.Name, track.Artists, track.Genre, track.AlbumTitle).Contains(_query.Trim(), StringComparison.OrdinalIgnoreCase)).ToList();
}
<div class="discover-page">
    <section class="music-hero">
        <div class="hero-badge"><span class="badge-covers">@foreach (var track in tracks.Take(3)) { <img src="@track.Cover" alt="" /> }</span><span>A little escape. A lot of good music.</span></div>
        <h1>Find your next<br /> <span class="gradient-phrase">favorite feeling.</span></h1>
        <p>From late-night mixes to your everyday soundtrack.<br class="hero-break" /> Discover the sounds, stories, and sessions of Collin.</p>
        <div class="hero-buttons"><button class="modern-button primary" type="button" disabled="@(featured is null)" @onclick="() => PlayerState.PlayQueue(tracks)"><span aria-hidden="true">▶</span> Start listening</button><a class="modern-button" href="/dj">Step into the DJ Room <span aria-hidden="true">↗</span></a></div>
        <div class="hero-meta"><span><i></i> @tracks.Count tracks to get lost in</span><span>@LibraryState.Albums.Count curated collections</span><span>One shared player</span></div>
    </section>
    <section class="music-collections" aria-labelledby="collections-title">
        <div class="modern-section-header"><div><span class="modern-eyebrow">FIND YOUR FREQUENCY</span><h2 id="collections-title">A collection for every mood.</h2><p>Handpicked journeys. Best experienced with your headphones on.</p></div><a class="section-link" href="/albums">Explore all collections <span aria-hidden="true">↗</span></a></div>
        <div class="collection-grid">@foreach (var album in LibraryState.Albums.Take(4)) { <a class="collection-card" href="@($"/albums/{album.Id}")"><div class="collection-art"><img src="@album.Cover" alt="@album.Title" loading="lazy" /><span class="collection-count">@album.Tracks.Count tracks</span><span class="collection-arrow" aria-hidden="true">↗</span></div><h3>@album.Title</h3><p>@album.Artist <span>Curated collection</span></p></a> }</div>
    </section>
    <section class="discover-library" id="tracks" aria-labelledby="tracks-title">
        <div class="modern-section-header"><div><span class="modern-eyebrow">THE GOOD STUFF</span><h2 id="tracks-title">Press play. Stay a while.</h2><p>Explore the full library, or find the one you came for.</p></div><label class="music-search"><span class="sr-only">Search the music library</span><span aria-hidden="true">⌕</span><input type="search" placeholder="Search tracks, artists, albums…" @bind="_query" @bind:event="oninput" /></label></div>
        <div class="library-toolbar"><span class="library-count" role="status">@filtered.Count tracks</span><a href="/favorites">Your saved tracks <span class="count-pill">@LibraryState.GetFavorites().Count</span> →</a></div>
        @if (filtered.Count == 0) { <div class="music-empty"><h3>No tracks found.</h3><p>Try another title, artist, or collection.</p><button type="button" class="modern-button" @onclick="() => _query = string.Empty">Clear search</button></div> }
        else { <div class="discover-tracks">@foreach (var track in filtered) { <TrackCard Track="track" /> }</div> }
    </section>
    <section class="dj-invitation"><div><span class="modern-eyebrow">YOUR NEXT SESSION STARTS HERE</span><h2>A little more hands-on?</h2><p>Take your listening to the decks. Your music goes with you.</p></div><a href="/dj" class="modern-button primary">Open the DJ Room <span aria-hidden="true">↗</span></a></section>
</div>
@code {
    private string _query = string.Empty;
    protected override void OnInitialized() => LibraryState.Changed += RefreshLibrary;
    private void RefreshLibrary() => InvokeAsync(StateHasChanged);
    public void Dispose() => LibraryState.Changed -= RefreshLibrary;
}
