@page "/albums"
@inject PlayerStateService PlayerState
@inject LibraryStateService LibraryState

<div class="albums-room">
    <header class="dj-heading">
        <div><span class="modern-eyebrow">COLLIN RADIO / COLLECTIONS</span><h1>A collection for <em>every feeling.</em></h1><p>From the first track to the last. Find your next listening session.</p></div>
        <a class="modern-button secondary" href="/dj">Enter the DJ Room ↗</a>
    </header>
    <div class="albums-summary"><span>@LibraryState.Albums.Count curated collections</span><span>Made for uninterrupted listening</span></div>
    <section class="albums-grid" aria-label="Album collections">
        @foreach (var album in LibraryState.Albums)
        {
            <article class="album-session">
                <a class="album-session-art" href="@($"/albums/{album.Id}")" aria-label="@($"Explore {album.Title}")"><img src="@album.Cover" alt="@($"{album.Title} artwork")" /><span aria-hidden="true">↗</span></a>
                <div class="album-session-body">
                    <span class="modern-eyebrow">@album.Tracks.Count TRACKS / COLLECTION</span>
                    <h2><a href="@($"/albums/{album.Id}")">@album.Title</a></h2>
                    <p>@album.Artist</p>
                    <div class="album-session-actions"><button class="modern-button" type="button" aria-label="@($"Play {album.Title}")" @onclick="() => PlayerState.PlayQueue(album.Tracks)"><span aria-hidden="true">▶</span> Play collection</button><a href="@($"/albums/{album.Id}")" aria-label="@($"View tracks in {album.Title}")">View tracks <span aria-hidden="true">↗</span></a></div>
                </div>
            </article>
        }
    </section>
    <aside class="albums-invitation"><div><span class="modern-eyebrow">TAKE IT TO THE DECK</span><h2>Your music. Your session.</h2><p>A turntable, your queue, and room to get lost in the sound.</p></div><a class="modern-button secondary" href="/dj">Open the DJ Room ↗</a></aside>
</div>
