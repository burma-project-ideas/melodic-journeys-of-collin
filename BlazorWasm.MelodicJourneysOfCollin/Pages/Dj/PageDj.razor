@page "/dj"
@inject PlayerStateService PlayerState
@inject LibraryStateService LibraryState
@implements IDisposable

<div class="dj-room">
    <header class="dj-heading">
        <div><span class="modern-eyebrow">COLLIN RADIO / DJ ROOM</span><h1>Your own little <em>listening room.</em></h1><p>Pick a sound. Settle into the session.</p></div>
        <a class="modern-button secondary" href="/">← Back to discovery</a>
    </header>
    <div class="dj-workspace">
        <section class="dj-deck" aria-label="Playback deck">
            <div class="dj-deck-top"><span class="modern-eyebrow">THE DECK</span><span class="dj-state">@(PlayerState.IsPlaying ? "● Playing" : "○ Ready when you are")</span></div>
            <div class="dj-record-stage"><div class="dj-record @(PlayerState.IsPlaying ? "is-playing" : "")">
                @if (CurrentTrack is not null) { <img src="@CurrentTrack.Cover" alt="@($"{DisplayName(CurrentTrack)} artwork")" /> }
                <span></span></div><div class="dj-tonearm" aria-hidden="true"></div>
            </div>
            <div class="dj-current"><div><span class="modern-eyebrow">NOW ON THE DECK</span><h2>@DisplayName(CurrentTrack)</h2><p>@CurrentTrack?.Artists</p></div>@if(CurrentTrack is not null){<FavoriteButton Track="CurrentTrack" />}</div>
            <div class="dj-progress"><input aria-label="Seek mixing track" type="range" min="0" max="@(Math.Max(PlayerState.Duration, 1))" step="0.1" value="@PlayerState.CurrentTime" @oninput="SeekTrack" /><div><span>@FormatTime(PlayerState.CurrentTime)</span><span>@FormatTime(PlayerState.Duration)</span></div></div>
            <div class="dj-controls"><button class="icon-button" aria-label="Previous mixing track" type="button" @onclick="PlayerState.PlayPrevious">‹‹</button><button class="transport-play" aria-label="@(PlayerState.IsPlaying ? "Pause mixing" : "Start mixing")" type="button" @onclick="PlayerState.TogglePlayback">@(PlayerState.IsPlaying ? "Ⅱ" : "▶")</button><button class="icon-button" aria-label="Next mixing track" type="button" @onclick="PlayerState.PlayNext">››</button></div>
            <label class="dj-volume">Volume<input aria-label="Mixing volume" type="range" min="0" max="1" step="0.01" value="@PlayerState.Volume" @oninput="SetVolume" /></label>
        </section>
        <section class="dj-crate" aria-labelledby="dj-queue-title">
            <div class="dj-crate-heading"><div><span class="modern-eyebrow">KEEP THE FEELING GOING</span><h2 id="dj-queue-title">Your session</h2></div><span class="dj-count">@DjQueue.Count tracks</span></div>
            <div class="dj-queue-list">
                @for(var i=0; i<DjQueue.Count; i++)
                {
                    var track=DjQueue[i];
                    var isCurrent=string.Equals(PlayerState.CurrentTrack?.Link,track.Link,StringComparison.OrdinalIgnoreCase);
                    <div class="dj-queue-item @(isCurrent ? "is-current" : "")">
                        <button type="button" class="dj-queue-track" aria-label="@($"Mix {DisplayName(track)}")" aria-pressed="@isCurrent" @onclick="() => PlayerState.PlayTrack(track)"><span class="dj-track-number">@((i+1).ToString("00"))</span><img src="@track.Cover" alt="" /><span class="dj-queue-name"><strong>@DisplayName(track)</strong><small>@track.Artists</small></span><span class="dj-track-play" aria-hidden="true">@(isCurrent && PlayerState.IsPlaying ? "Ⅱ" : "▶")</span></button>
                        <FavoriteButton Track="track" />
                    </div>
                }
            </div>
        </section>
    </div>
    <section class="dj-collections" aria-labelledby="dj-collections-title"><div class="dj-collection-heading"><div><span class="modern-eyebrow">CHANGE THE MOOD</span><h2 id="dj-collections-title">A new direction, one click away.</h2></div><a href="/albums">Explore collections ↗</a></div><div class="dj-album-grid">
        @foreach(var album in LibraryState.Albums.Take(4)) { <button type="button" @onclick="() => PlayerState.PlayQueue(album.Tracks)"><img src="@album.Cover" alt="" /><span><strong>@album.Title</strong><small>@album.Tracks.Count tracks · Play collection</small></span><span aria-hidden="true">↗</span></button> }
    </div></section>
</div>
@code {
    protected override void OnInitialized() => PlayerState.Changed += RefreshPlayer;
    private void RefreshPlayer() => InvokeAsync(StateHasChanged);
    public void Dispose() => PlayerState.Changed -= RefreshPlayer;
    private IReadOnlyList<MusicInfoModel> DjQueue => PlayerState.Queue.Count > 0 ? PlayerState.Queue : MusicService.LocalPlaylist;
    private MusicInfoModel? CurrentTrack => PlayerState.CurrentTrack ?? DjQueue.FirstOrDefault();

    private void SetVolume(ChangeEventArgs args)
    {
        if (double.TryParse(args.Value?.ToString(), out var value)) PlayerState.SetVolume(value);
    }

    private void SeekTrack(ChangeEventArgs args)
    {
        if (double.TryParse(args.Value?.ToString(), out var value))
        {
            PlayerState.RequestSeek(value);
        }
    }

    private static string DisplayName(MusicInfoModel? track)
        => (track?.Name ?? "Select a track").Replace(".mp3", string.Empty, StringComparison.OrdinalIgnoreCase);

    private static string FormatTime(double seconds)
    {
        if (seconds <= 0)
        {
            return "00:00";
        }

        var time = TimeSpan.FromSeconds(seconds);
        return time.TotalHours >= 1 ? $"{(int)time.TotalHours:00}:{time.Minutes:00}:{time.Seconds:00}" : $"{time.Minutes:00}:{time.Seconds:00}";
    }
}
