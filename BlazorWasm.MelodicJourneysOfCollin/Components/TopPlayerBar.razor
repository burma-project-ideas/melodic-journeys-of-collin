@inject PlayerStateService PlayerState
@inject LibraryStateService LibraryState
@implements IDisposable

<section class="now-playing" aria-label="Music player">
    @if (PlayerState.IsPlaylistOpen)
    {
        <div class="player-queue" aria-label="Playback queue">
            <div class="queue-heading"><div><span class="modern-eyebrow">UP NEXT</span><h2>Your listening queue</h2></div><button class="icon-button" type="button" @onclick="PlayerState.ClosePlaylist" aria-label="Close queue">×</button></div>
            <div class="queue-list">@for (var index = 0; index < PlayerState.Queue.Count; index++) { var queueIndex = index; var track = PlayerState.Queue[index]; <div class="queue-row"><button type="button" class="queue-track" @onclick="() => PlayerState.PlayTrackAt(queueIndex)" aria-label="@($"Play queued {DisplayName(track)}")"><span>@((index+1).ToString("00"))</span><img src="@track.Cover" alt="" /><span><strong>@DisplayName(track)</strong><small>@track.Artists</small></span></button><FavoriteButton Track="track" /></div> }</div>
        </div>
    }
    <div class="player-row">
        <div class="playing-track">@if (PlayerState.CurrentTrack is not null) { <img src="@PlayerState.CurrentTrack.Cover" alt="" /> }<div><span class="modern-eyebrow">YOUR CURRENT SOUNDTRACK</span><strong>@TrackTitle</strong><small>@TrackArtist</small></div></div>
        <div class="player-transport"><div class="transport-buttons"><button type="button" class="icon-button" @onclick="PlayerState.PlayPrevious" aria-label="Previous track">‹‹</button><button type="button" class="transport-play" @onclick="PlayerState.TogglePlayback" aria-label="@(PlayerState.IsPlaying ? "Pause playback" : "Start playback")">@(PlayerState.IsPlaying ? "Ⅱ" : "▶")</button><button type="button" class="icon-button" @onclick="PlayerState.PlayNext" aria-label="Next track">››</button></div><div class="player-timeline"><span>@FormatTime(PlayerState.CurrentTime)</span><input aria-label="Seek track" type="range" min="0" max="@(Math.Max(PlayerState.Duration,1))" step="0.1" value="@PlayerState.CurrentTime" @oninput="SeekTrack" /><span>@FormatTime(PlayerState.Duration)</span></div></div>
        <div class="player-tools">@if (PlayerState.CurrentTrack is not null) { <FavoriteButton Track="PlayerState.CurrentTrack" /> }<button class="queue-toggle" type="button" @onclick="PlayerState.TogglePlaylist" aria-expanded="@PlayerState.IsPlaylistOpen">Queue <span>@PlayerState.Queue.Count</span></button><label class="player-volume"><span>Volume</span><input aria-label="Volume" type="range" min="0" max="1" step="0.01" value="@PlayerState.Volume" @oninput="SetVolume" /></label></div>
    </div>
</section>

@code {
    private string TrackTitle => PlayerState.CurrentTrack is null ? "Select a track" : DisplayName(PlayerState.CurrentTrack);
    private string TrackArtist => PlayerState.CurrentTrack?.Artists ?? "Collin";

    private void SetVolume(ChangeEventArgs args)
    {
        if (double.TryParse(args.Value?.ToString(), out var value))
        {
            PlayerState.SetVolume(value);
        }
    }

    private void SeekTrack(ChangeEventArgs args)
    {
        if (double.TryParse(args.Value?.ToString(), out var value))
        {
            PlayerState.RequestSeek(value);
        }
    }

    private static string FormatTime(double seconds)
    {
        if (seconds <= 0)
        {
            return "00:00";
        }

        var time = TimeSpan.FromSeconds(seconds);
        return time.TotalHours >= 1 ? $"{(int)time.TotalHours:00}:{time.Minutes:00}:{time.Seconds:00}" : $"{time.Minutes:00}:{time.Seconds:00}";
    }

    private static string DisplayName(MusicInfoModel track) => (track.Name ?? string.Empty).Replace(".mp3", string.Empty, StringComparison.OrdinalIgnoreCase);
    protected override void OnInitialized() => PlayerState.Changed += RefreshPlayer;
    private void RefreshPlayer() => InvokeAsync(StateHasChanged);
    public void Dispose() => PlayerState.Changed -= RefreshPlayer;
}
