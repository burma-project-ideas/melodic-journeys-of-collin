@inject PlayerStateService PlayerState
<article class="music-track">
    <div class="track-cover"><img src="@Track.Cover" alt="@DisplayName artwork" loading="lazy" /></div>
    <div class="track-details"><span class="track-genre">@Track.Genre <span>·</span> @Track.Length</span><h3>@DisplayName</h3><p>@Track.Artists <span>· @Track.AlbumTitle</span></p></div>
    <div class="track-actions"><FavoriteButton Track="Track" /><button class="track-play" type="button" aria-label="@($"Play {DisplayName}")" @onclick="PlayTrack"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" class="h-5 w-5 fill-current" aria-hidden="true"><path d="M8 5v14l11-7z"/></svg></button></div>
</article>
@code {
    [Parameter, EditorRequired] public MusicInfoModel Track { get; set; } = default!;
    private string DisplayName => (Track.Name ?? string.Empty).Replace(".mp3", string.Empty, StringComparison.OrdinalIgnoreCase);
    private void PlayTrack() => PlayerState.PlayTrack(Track);
}
