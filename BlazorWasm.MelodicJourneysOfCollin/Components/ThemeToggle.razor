@inject ThemeService ThemeService
@inject IJSRuntime JsRuntime
@implements IDisposable

<button class="theme-toggle" type="button" @onclick="ToggleTheme" aria-label="@($"Change theme, current setting: {Label}")" title="@Label">
    <span aria-hidden="true">@(ThemeService.Preference switch { ThemePreference.Light => "☼", ThemePreference.Dark => "☾", _ => "◐" })</span>
    <span class="sr-only">@Label</span>
</button>

@code {
    private string Label => ThemeService.Preference switch
    {
        ThemePreference.Light => "Light mode",
        ThemePreference.Dark => "Dark mode",
        _ => ThemeService.IsDark ? "System dark" : "System light"
    };

    protected override void OnInitialized()
    {
        ThemeService.Changed += OnThemeChanged;
    }

    private async Task ToggleTheme()
    {
        await ThemeService.CycleAsync(JsRuntime);
    }

    private void OnThemeChanged()
    {
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        ThemeService.Changed -= OnThemeChanged;
    }
}
